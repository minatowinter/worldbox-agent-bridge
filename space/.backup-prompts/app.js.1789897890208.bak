'use strict';

/* =====================================================================
 * Agent Room 前端 —— 多房间 / 角色内心 / 三种发言模式
 * ===================================================================== */

const $ = (id) => document.getElementById(id);

const S = {
  rooms: [],            // 房间列表（精简信息）
  active: null,         // 当前房间完整状态
  running: false,
  runningRoomId: null,
  online: false,
  editingFile: null,
  innerAgentId: null,   // 正在查看谁的内心
  thinking: new Set(),  // 正在思考/判断的 agentId
  innerOnlyAct: false,
};

const KIND = {
  think:  { icon: '💭', label: '思考' },
  tool:   { icon: '🔧', label: '工具' },
  decide: { icon: '🎯', label: '判断' },
  speak:  { icon: '🗣', label: '发言' },
  policy: { icon: '📜', label: '国策' },
  error:  { icon: '⚠️', label: '错误' },
  step:   { icon: '•',  label: '步骤' },
};

const ACTION_STATUS = {
  proposed: { label: '待执行', cls: 'proposed' },
  unparsed: { label: '待解析', cls: 'unparsed' },
  executed: { label: '已执行', cls: 'executed' },
  rejected: { label: '被拒绝', cls: 'rejected' },
  obsolete: { label: '已过期', cls: 'obsolete' },
};

/* ------------------------- 工具函数 ------------------------- */

function esc(s) {
  return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function fmtTime(ts) {
  return new Date(ts).toLocaleTimeString('zh-CN', { hour12: false });
}
function fmtSize(n) {
  if (n < 1024) return n + ' B';
  if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
  return (n / 1048576).toFixed(1) + ' MB';
}
function escapeRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

function renderText(text) {
  let html = esc(text);
  const names = (S.active?.agents || []).map((a) => a.name).filter(Boolean).sort((a, b) => b.length - a.length);
  for (const n of names) {
    html = html.replace(new RegExp('@' + escapeRe(esc(n)) + '(?![\\w\\u4e00-\\u9fa5])', 'g'), (m) => `<span class="mention">${m}</span>`);
  }
  return html;
}

function toast(msg, kind = '') {
  const el = document.createElement('div');
  el.className = 'toast ' + kind;
  el.textContent = msg;
  $('toasts').appendChild(el);
  setTimeout(() => {
    el.style.opacity = '0'; el.style.transition = 'opacity .3s';
    setTimeout(() => el.remove(), 320);
  }, 4200);
}

async function api(path, opts = {}) {
  const res = await fetch(path, {
    method: opts.method || 'GET',
    headers: opts.body ? { 'Content-Type': 'application/json' } : undefined,
    body: opts.body ? JSON.stringify(opts.body) : undefined,
  });
  const text = await res.text();
  let data = {};
  try { data = text ? JSON.parse(text) : {}; } catch { data = { error: text }; }
  if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
  return data;
}

function isActive(roomId) { return roomId == null || (S.active && roomId === S.active.id); }

/* ------------------------- 渲染：房间切换 ------------------------- */

function renderRoomSelect() {
  const sel = $('roomSelect');
  sel.innerHTML = S.rooms
    .map((r) => {
      const icon = r.kind === 'worldbox' ? '🌍 ' : '';
      const pend = r.actionCounts && r.actionCounts.proposed ? ` · 待执行${r.actionCounts.proposed}` : '';
      return `<option value="${r.id}">${icon}${esc(r.name)} · ${r.agents.length}人${r.messageCount ? ' · ' + r.messageCount + '条' : ''}${pend}</option>`;
    })
    .join('');
  if (S.active) sel.value = S.active.id;
}

/* ------------------------- 渲染：角色 ------------------------- */

function renderAgents() {
  const box = $('agentList');
  if (!S.active) { box.innerHTML = ''; $('agentCount').textContent = '0'; return; }
  const agents = S.active.agents;
  $('agentCount').textContent = agents.length;
  box.innerHTML = '';
  if (!agents.length) {
    box.innerHTML = '<div class="file-empty">还没有角色。<br>点右上角「+ 新建」添加一个。</div>';
    return;
  }
  for (const a of agents) {
    const busy = S.thinking.has(a.id) || (S.active.currentAgentId === a.id);
    const ro = a.canModifyFiles === false;
    const st = a.stats || {};
    const card = document.createElement('div');
    card.className = 'agent-card' + (a.enabled ? '' : ' disabled') + (busy ? ' speaking' : '');
    card.innerHTML = `
      <div class="accent-bar" style="background:${esc(a.color || '#5b8cff')}"></div>
      <div class="agent-top">
        <div class="agent-avatar" style="border-color:${esc(a.color || '#5b8cff')}">${esc(a.emoji || '🤖')}</div>
        <div style="flex:1;min-width:0">
          <div class="agent-name" style="color:${esc(a.color || '#5b8cff')}">
            ${esc(a.name)} ${ro ? '<span class="badge-ro" title="只读：不能修改工作区文件">🔒 只读</span>' : ''}
          </div>
          <div class="agent-meta" title="${esc(a.model)}">${esc(a.model)}${a.hasKey ? '' : ' · <span style="color:#e2b04a">未配置 Key</span>'}</div>
        </div>
        ${busy ? '<div class="thinking-badge"><i></i><i></i><i></i></div>' : ''}
      </div>
      <div class="agent-stats">回合 ${st.turns || 0} · token ${(st.promptTokens || 0) + (st.completionTokens || 0)} · 内心 ${a.innerCount || 0}${st.errors ? ` · <span style="color:#ff6b6b">错误 ${st.errors}</span>` : ''}</div>
      <div class="agent-actions">
        <button class="btn tiny" data-act="speak" data-id="${a.id}" ${a.enabled ? '' : 'disabled'}>发言</button>
        <button class="btn tiny ghost" data-act="inner" data-id="${a.id}">内心</button>
        <button class="btn tiny ghost" data-act="edit" data-id="${a.id}">编辑</button>
        <button class="btn tiny ghost" data-act="toggle" data-id="${a.id}">${a.enabled ? '停用' : '启用'}</button>
        <button class="btn tiny danger" data-act="del" data-id="${a.id}">删除</button>
      </div>`;
    box.appendChild(card);
  }
}

/* ------------------------- 渲染：房间对话 ------------------------- */

function messageEl(m) {
  const el = document.createElement('div');
  el.className = 'msg ' + (m.role === 'agent' ? 'agent' : m.role);
  el.dataset.id = m.id;

  if (m.role === 'system') {
    el.innerHTML = `<div class="msg-body"><div class="msg-text">${renderText(m.text || '')}</div></div>`;
    return el;
  }
  const color = m.color || '#8f9bb3';
  const innerLink = m.role === 'agent'
    ? `<span class="inner-link" data-agent="${m.agentId}">💭 内心${m.toolCount ? ' · ' + m.toolCount + ' 次工具' : ''}</span>`
    : '';
  el.innerHTML = `
    <div class="msg-avatar" style="border-color:${esc(color)}">${esc(m.emoji || (m.role === 'user' ? '🧑' : '🤖'))}</div>
    <div class="msg-body">
      <div class="msg-head">
        <span class="msg-name" style="color:${esc(color)}">${esc(m.name || '未知')}</span>
        ${m.model ? `<span class="msg-badge">${esc(m.model)}</span>` : ''}
        <span class="msg-time">${fmtTime(m.ts)}</span>
        ${innerLink}
      </div>
      <div class="msg-text">${renderText(m.text || '')}</div>
    </div>`;
  return el;
}

function emptyHint() {
  return `<div class="empty-hint" id="emptyHint">
    <div class="big">🤝</div>
    <p>房间里还没有人说话。在下面输入内容，或点右上角 <b>▶ 开始</b> 让角色们自己开口。</p>
    <p class="small">提示：用 <code>@名字</code> 可以直接点名某个角色发言。</p>
  </div>`;
}

function renderMessages() {
  const box = $('chatScroll');
  const msgs = S.active ? S.active.messages : [];
  box.innerHTML = msgs.length ? '' : emptyHint();
  msgs.forEach((m) => box.appendChild(messageEl(m)));
  box.scrollTop = box.scrollHeight;
}

function appendMessage(m) {
  if (document.querySelector(`.msg[data-id="${m.id}"]`)) return;
  const box = $('chatScroll');
  const hint = $('emptyHint');
  if (hint) hint.remove();
  box.appendChild(messageEl(m));
  const near = box.scrollHeight - box.scrollTop - box.clientHeight < 200;
  if (near) box.scrollTop = box.scrollHeight;
}

/* ------------------------- 渲染：内心 ------------------------- */

function innerEntryEl(e) {
  const k = KIND[e.kind] || KIND.step;
  const el = document.createElement('div');
  el.className = 'inner-entry kind-' + e.kind;
  let extra = '';
  if (e.tool) {
    const t = e.tool;
    extra = `<details class="tool-block" ${t.ok ? '' : 'open'}>
      <summary><span class="tool-tag ${t.ok ? '' : 'fail'}">${t.ok ? 'TOOL' : 'ERR'}</span>
        ${esc(t.name)}${t.args && t.args.path ? ' → ' + esc(t.args.path) : ''}</summary>
      <div class="tool-body">${esc(
        (t.args && t.args.content != null ? '写入内容（前 1200 字）：\n' + String(t.args.content).slice(0, 1200) + '\n\n' : '') +
        '结果：\n' + (t.result || '')
      )}</div></details>`;
  }
  el.innerHTML = `
    <div class="inner-head-line">
      <span class="inner-kind kind-${e.kind}">${k.icon} ${k.label}</span>
      <span class="inner-time">${fmtTime(e.ts)}</span>
      ${e.meta && e.meta.ms ? `<span class="inner-time">${e.meta.ms}ms</span>` : ''}
    </div>
    ${e.text ? `<div class="inner-text">${esc(e.text)}</div>` : ''}
    ${extra}`;
  return el;
}

function renderInner() {
  const drawer = $('innerDrawer');
  if (!S.innerAgentId || !S.active) { drawer.hidden = true; return; }
  const agent = S.active.agents.find((a) => a.id === S.innerAgentId);
  if (!agent) { S.innerAgentId = null; drawer.hidden = true; return; }

  const entries = (S.active.inner || {})[S.innerAgentId] || [];
  $('innerTitle').textContent = `${agent.emoji || '🤖'} ${agent.name} 的内心`;
  $('innerSub').textContent = `${entries.length} 条记录 · 房间里只会出现 TA 的正式发言`;
  const list = $('innerList');
  list.innerHTML = '';
  const shown = S.innerOnlyAct ? entries.filter((e) => e.kind !== 'think') : entries;
  if (!shown.length) {
    list.innerHTML = '<div class="file-empty">还没有记录。<br>让 TA 发言一次，或点「↻」刷新。</div>';
  } else {
    shown.forEach((e) => list.appendChild(innerEntryEl(e)));
  }
  list.scrollTop = list.scrollHeight;
  drawer.hidden = false;
}

function appendInner(roomId, agentId, entry) {
  if (!isActive(roomId) || !S.active) return;
  const map = (S.active.inner ||= {});
  (map[agentId] ||= []).push(entry);
  const a = S.active.agents.find((x) => x.id === agentId);
  if (a) a.innerCount = (a.innerCount || 0) + 1;
  renderAgents();
  if (S.innerAgentId === agentId) renderInner();
}

/* ------------------------- 渲染：世界状态 & 待执行清单 ------------------------- */

function renderWorldBar() {
  const bar = $('worldBar');
  const wb = S.active && S.active.worldbox;
  if (!wb || !wb.enabled) { bar.hidden = true; $('actionsTab').hidden = true; document.body.classList.remove('has-world'); return; }
  bar.hidden = false;
  document.body.classList.add('has-world');
  $('actionsTab').hidden = false;

  const line = $('worldLine');
  // 顺便说清"当前用哪份存档"：跟随最新 / 已锁定某个 key
  line.textContent = (wb.line || '（世界服务不可用）') +
    (wb.saveKey ? `  ·  存档 ${wb.saveKey}` : '  ·  跟随最新存档');
  line.className = 'world-line' + (wb.available ? (wb.status && wb.status.stale ? ' stale' : ' ok') : ' down');

  $('worldStrictChk').checked = wb.strictTick !== false;
}

function renderActions() {
  const wb = S.active && S.active.worldbox;
  const actions = (S.active && S.active.actions) || [];
  const pending = actions.filter((a) => a.status === 'proposed' || a.status === 'unparsed');
  $('actionCount').textContent = wb && wb.enabled ? pending.length : 0;
  const box = $('actionList');
  if (!box) return;

  const cap = (wb && wb.maxActionsPerTurn) || 3;
  $('budgetHint').innerHTML = `每个领袖每轮最多提出 <b>${cap}</b> 条动作（轻度、小步、可逆）；` +
    `说话/谈判/结盟不占额度。当前待执行 <b>${pending.filter((a) => a.status === 'proposed').length}</b> 条。`;

  if (!actions.length) {
    box.innerHTML = '<div class="file-empty">还没有《国策》提案。<br>让领袖们发言后，可执行动作会自动抽取到这里。</div>';
    return;
  }
  // 待执行的排前面，其余按时间倒序
  const order = { proposed: 0, unparsed: 1, executed: 2, rejected: 3, obsolete: 4 };
  const sorted = actions.slice().sort((a, b) => (order[a.status] ?? 9) - (order[b.status] ?? 9) || b.createdAt - a.createdAt);

  box.innerHTML = '';
  for (const a of sorted) {
    const meta = ACTION_STATUS[a.status] || ACTION_STATUS.proposed;
    const el = document.createElement('div');
    el.className = 'action-item status-' + meta.cls;
    el.innerHTML = `
      <div class="action-head">
        <span class="action-nation">${esc(a.nation || '?')}</span>
        <span class="action-kind">${esc(a.kind || '')}</span>
        <span class="action-status s-${meta.cls}">${meta.label}</span>
      </div>
      <div class="action-summary">${esc(a.summary || '')}</div>
      ${a.coord ? `<div class="action-coord">📍 ${esc(a.target || '')} (${a.coord[0]},${a.coord[1]})</div>` : ''}
      ${a.note ? `<div class="action-note">${esc(a.note)}</div>` : ''}
      <div class="action-btns">
        ${a.status === 'proposed' || a.status === 'unparsed'
          ? `<button class="btn tiny primary" data-decide="executed" data-id="${a.id}">✅ 已执行</button>
             <button class="btn tiny danger" data-decide="rejected" data-id="${a.id}">❌ 被拒绝</button>`
          : `<button class="btn tiny ghost" data-decide="proposed" data-id="${a.id}">↺ 改回待执行</button>`}
        ${a.raw ? `<button class="btn tiny ghost" data-raw="${a.id}">原文</button>` : ''}
      </div>
      ${a.raw && a.status === 'unparsed' ? `<details class="action-raw"><summary>查看国策原文</summary><div>${esc(a.raw)}</div></details>` : ''}`;
    box.appendChild(el);
  }
}

function switchTab(tab) {
  document.querySelectorAll('.tabs .tab').forEach((t) => t.classList.toggle('active', t.dataset.tab === tab));
  $('filesPane').hidden = tab !== 'files';
  $('actionsPane').hidden = tab !== 'actions';
}

/* ------------------------- 渲染：文件 ------------------------- */

function renderFiles() {
  const files = (S.active && S.active.files) || [];
  $('fileCount').textContent = files.length;
  $('workspacePath').textContent = S.active ? `room/${S.active.dir}/` : '';
  const box = $('fileList');
  box.innerHTML = '';
  if (!files.length) {
    box.innerHTML = '<div class="file-empty">这个房间的工作区是空的。<br>角色调用 write_file 后会出现在这里。</div>';
    return;
  }
  for (const f of files) {
    const el = document.createElement('div');
    el.className = 'file-item' + (S.editingFile === f.path ? ' active' : '');
    el.innerHTML = `<span>📄</span><span class="fname">${esc(f.path)}</span><span class="fsize">${fmtSize(f.size)}</span>`;
    el.onclick = () => openFile(f.path);
    box.appendChild(el);
  }
}

async function refreshFiles() {
  if (!S.active) return;
  try {
    const d = await api('/api/files');
    S.active.files = d.files || [];
    renderFiles();
  } catch { /* 静默 */ }
}

async function openFile(p) {
  try {
    const d = await api('/api/file?path=' + encodeURIComponent(p));
    S.editingFile = d.path;
    $('fileEditor').hidden = false;
    $('editorPath').textContent = d.path;
    $('fileContent').value = d.content;
    renderFiles();
  } catch (e) { toast('打开文件失败：' + e.message, 'err'); }
}

/* ------------------------- 渲染：状态 ------------------------- */

function renderStatus() {
  const pill = $('statusPill'), txt = $('statusText');
  const roomRunning = S.running && S.runningRoomId === S.active?.id;
  pill.className = 'status-pill' + (S.online ? ' online' : '') + (roomRunning ? ' running' : '');
  if (!S.online) txt.textContent = '未连接';
  else if (roomRunning) {
    const cur = S.active && S.active.agents.find((a) => a.id === S.active.currentAgentId);
    txt.textContent = cur ? `${cur.name} 正在工作…` : '运行中…';
  } else if (S.running) {
    const r = S.rooms.find((x) => x.id === S.runningRoomId);
    txt.textContent = `「${r ? r.name : '其他房间'}」运行中`;
    pill.className = 'status-pill online running';
  } else txt.textContent = '空闲';

  $('startBtn').disabled = S.running;
  $('stopBtn').disabled = !S.running;
  if (!S.active) return;
  $('modeSelect').value = S.active.mode || 'round_robin';
  $('roundsInput').value = S.active.rounds ?? 2;
  $('roomTitle').textContent = S.active.name || 'Agent Room';
  document.title = (S.active.name || 'Agent Room') + ' · Agent Room';
  $('settingText').textContent = S.active.setting || '—';
  $('settingText').title = S.active.setting || '';
  $('roundsInput').disabled = S.active.mode === 'on_demand';

  const hints = {
    round_robin: '轮流发言：每轮所有启用的角色各说一次。',
    on_demand: '按需发言：每次发言后，系统会让其他角色各自判断"我要不要说话"，需要的人才会开口。会产生额外判断调用。',
    manual: '手动点名：不自动排队，点某个角色的「发言」才会说话。',
  };
  $('modeHint').textContent = hints[S.active.mode] || '';
}

function renderAll() {
  renderRoomSelect();
  renderAgents();
  renderMessages();
  renderFiles();
  renderInner();
  renderWorldBar();
  renderActions();
  renderStatus();
}

/* ------------------------- 加载 & SSE ------------------------- */

async function loadState() {
  const d = await api('/api/state');
  S.rooms = d.rooms || [];
  S.active = d.active;
  S.running = d.running;
  S.runningRoomId = d.runningRoomId;
  S.thinking.clear();
  if (S.innerAgentId && !S.active.agents.some((a) => a.id === S.innerAgentId)) S.innerAgentId = null;
  renderAll();
}

function connectSSE() {
  const es = new EventSource('/api/events');
  es.addEventListener('hello', () => { S.online = true; renderStatus(); });
  es.onopen = () => { S.online = true; renderStatus(); };
  es.onerror = () => { S.online = false; renderStatus(); };

  es.addEventListener('rooms', async (e) => {
    const d = JSON.parse(e.data);
    const before = S.active?.id;
    S.rooms = d.rooms || [];
    S.running = d.running;
    S.runningRoomId = d.runningRoomId;
    if (d.activeRoomId !== before) await loadState();
    renderRoomSelect();
    renderStatus();
  });

  es.addEventListener('message', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.roomId)) { const r = S.rooms.find((x) => x.id === d.roomId); if (r) r.messageCount = (r.messageCount || 0) + 1; return; }
    S.active.messages.push(d.message);
    S.active.agents.forEach((a) => S.thinking.delete(a.id));
    renderAgents();
    appendMessage(d.message);
  });

  es.addEventListener('inner', (e) => {
    const d = JSON.parse(e.data);
    appendInner(d.roomId, d.agentId, d.entry);
  });

  es.addEventListener('tool-live', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.roomId)) return;
    S.thinking.add(d.agentId);
    renderAgents();
  });

  es.addEventListener('inner-status', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.roomId)) return;
    if (d.phase === 'thinking') S.thinking.add(d.agentId);
    else S.thinking.delete(d.agentId);
    renderAgents();
  });

  es.addEventListener('deciding', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.roomId)) return;
    d.agentIds.forEach((id) => S.thinking.add(id));
    renderAgents();
  });

  es.addEventListener('agents', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.roomId)) return;
    S.active.agents = d.agents;
    renderAgents();
  });

  es.addEventListener('room', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.id)) return;
    Object.assign(S.active, d);
    renderStatus();
    renderRoomSelect();
  });

  es.addEventListener('run', (e) => {
    const d = JSON.parse(e.data);
    S.running = d.running;
    S.runningRoomId = d.runningRoomId || null;
    if (isActive(d.roomId)) {
      S.active.currentAgentId = d.currentAgentId || null;
      if (!d.running) S.thinking.clear();
      renderAgents();
    }
    renderStatus();
  });

  es.addEventListener('queue', (e) => {
    const d = JSON.parse(e.data);
    if (isActive(d.roomId) && !d.queue.length) { S.thinking.clear(); renderAgents(); }
  });

  es.addEventListener('workspace', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.roomId)) return;
    refreshFiles();
    if (S.editingFile) openFile(S.editingFile);
  });

  es.addEventListener('actions', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.roomId) || !S.active) return;
    S.active.actions = d.actions;
    renderActions();
  });

  es.addEventListener('world', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.roomId) || !S.active || !S.active.worldbox) return;
    S.active.worldbox.status = d.status;
    if (!d.status) { S.active.worldbox.available = false; S.active.worldbox.line = '⚠️ 世界服务不可用'; }
    else {
      S.active.worldbox.available = true;
      const st = d.status;
      const mins = (st.saveAgeSeconds / 60).toFixed(1);
      S.active.worldbox.line = `🌍 ${st.worldName} 第 ${st.year} 年 · 存活 ${st.liveKingdoms}/${st.kingdoms} 国` +
        (st.stale ? `  ⚠️ 数据已 ${mins} 分钟旧，可能已过期` : `  数据 ${mins} 分钟前`);
      S.active.worldbox.lastFingerprint = st.fingerprint;
    }
    renderWorldBar();
  });

  es.addEventListener('reset', (e) => {
    const d = JSON.parse(e.data);
    if (!isActive(d.roomId)) return;
    S.active.messages = [];
    S.active.inner = {};
    S.active.agents.forEach((a) => (a.innerCount = 0));
    renderMessages(); renderAgents(); renderInner();
  });
}

/* ------------------------- 交互：房间 ------------------------- */

$('roomSelect').onchange = async (e) => {
  try { await api('/api/rooms/activate', { method: 'POST', body: { id: e.target.value } }); await loadState(); }
  catch (err) { toast('切换房间失败：' + err.message, 'err'); }
};

$('newRoomBtn').onclick = () => {
  $('nr_name').value = `房间 ${S.rooms.length + 1}`;
  document.querySelector('input[name="nr_kind"][value="normal"]').checked = true;
  $('nr_baseUrlField').hidden = true;
  $('newRoomModal').hidden = false;
  setTimeout(() => $('nr_name').focus(), 30);
};

document.querySelectorAll('input[name="nr_kind"]').forEach((r) => {
  r.onchange = () => { $('nr_baseUrlField').hidden = r.value !== 'worldbox' || !r.checked; };
});

$('createRoomBtn').onclick = async () => {
  const name = $('nr_name').value.trim();
  const kind = (document.querySelector('input[name="nr_kind"]:checked') || {}).value || 'normal';
  const btn = $('createRoomBtn');
  btn.disabled = true; btn.textContent = kind === 'worldbox' ? '连接世界中…' : '创建中…';
  try {
    const d = await api('/api/rooms/create', {
      method: 'POST',
      body: { name, kind, baseUrl: $('nr_baseUrl').value.trim() || undefined },
    });
    $('newRoomModal').hidden = true;
    await loadState();
    toast(`已创建「${d.room.name}」→ room/${d.room.dir}/` + (d.note ? ` · ${d.note}` : ''), 'ok');
  } catch (e) { toast('创建失败：' + e.message, 'err'); }
  finally { btn.disabled = false; btn.textContent = '创建'; }
};

/* ------------------------- 交互：WorldBox 世界 ------------------------- */

$('worldRefreshBtn').onclick = async () => {
  try {
    const d = await api('/api/worldbox/refresh', { method: 'POST', body: {} });
    S.active.worldbox = d.worldbox;
    S.active.actions = d.actions || S.active.actions;
    renderWorldBar(); renderActions();
    toast(d.ok ? '世界状态已刷新' : '世界服务不可用', d.ok ? 'ok' : 'err');
  } catch (e) { toast('刷新失败：' + e.message, 'err'); }
};

$('worldForceBtn').onclick = async () => {
  try {
    await api('/api/run', { method: 'POST', body: { mode: S.active.mode, rounds: S.active.rounds, force: true } });
    toast('已强制开启一轮（忽略世界节拍）', 'ok');
  } catch (e) { toast('启动失败：' + e.message, 'err'); }
};

$('worldCfgBtn').onclick = openRoomModal;

$('worldStrictChk').onchange = async (e) => {
  try {
    await api('/api/worldbox', { method: 'POST', body: { strictTick: e.target.checked } });
    toast(e.target.checked ? '已开启世界节拍' : '已关闭世界节拍');
  } catch (err) { toast('设置失败：' + err.message, 'err'); }
};

$('actionsTab').onclick = () => switchTab('actions');

document.querySelectorAll('.tabs .tab').forEach((t) => { t.onclick = () => switchTab(t.dataset.tab); });

$('actionList').addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-decide]');
  if (!btn) return;
  const id = btn.dataset.id;
  const status = btn.dataset.decide;
  let note = '';
  if (status === 'rejected') note = prompt('拒绝原因（会回填给领袖，可留空）：', '') || '';
  if (status === 'executed') note = prompt('执行说明（会回填给领袖，可留空）：', '') || '';
  try {
    const d = await api('/api/worldbox/action', { method: 'POST', body: { id, status, note } });
    const idx = S.active.actions.findIndex((a) => a.id === id);
    if (idx >= 0) S.active.actions[idx] = d.action;
    renderActions();
    toast('已记录裁决，下一轮会回填给领袖', 'ok');
  } catch (err) { toast('操作失败：' + err.message, 'err'); }
});

$('copyActionsBtn').onclick = async () => {
  const pending = (S.active.actions || []).filter((a) => a.status === 'proposed');
  if (!pending.length) { toast('没有待执行的动作'); return; }
  const text = pending.map((a, i) =>
    `${i + 1}. [${a.nation}] ${a.kind === '开关型' ? a.summary : `${a.summary}  → ${a.target}(${a.coord[0]},${a.coord[1]})`}`
  ).join('\n');
  try { await navigator.clipboard.writeText(text); toast(`已复制 ${pending.length} 条待执行清单`, 'ok'); }
  catch { prompt('复制下面的清单：', text); }
};

$('clearDecidedBtn').onclick = async () => {
  if (!confirm('清掉所有已裁决（已执行/被拒绝/已过期）的条目？')) return;
  const d = await api('/api/worldbox/clear', { method: 'POST', body: { keep: ['proposed', 'unparsed'] } });
  S.active.actions = d.actions;
  renderActions();
};

$('renameRoomBtn').onclick = async () => {
  if (!S.active) return;
  const name = prompt('新的房间名：', S.active.name);
  if (name === null || !name.trim()) return;
  await api('/api/rooms/update', { method: 'POST', body: { id: S.active.id, name: name.trim() } });
  await loadState();
};

$('deleteRoomBtn').onclick = async () => {
  if (!S.active) return;
  if (!confirm(`删除房间「${S.active.name}」？\n对话记录会被清除；工作区目录 room/${S.active.dir}/ 里的文件会保留。`)) return;
  try {
    const d = await api('/api/rooms/delete', { method: 'POST', body: { id: S.active.id } });
    await loadState();
    toast('房间已删除，文件保留在 ' + d.keptFiles, 'ok');
