/* ------------------------- 交互：角色列表 ------------------------- */

$('agentList').addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-act]');
  if (!btn) return;
  const { act, id } = btn.dataset;
  const agent = S.active && S.active.agents.find((a) => a.id === id);
  if (!agent) return;
  if (act === 'speak') {
    try { await api('/api/step', { method: 'POST', body: { agentId: id } }); toast(`已让 ${agent.name} 发言`); }
    catch (e) { toast('失败：' + e.message, 'err'); }
  } else if (act === 'inner') {
    S.innerAgentId = id;
    renderInner();
  } else if (act === 'toggle') {
    await api('/api/agents', { method: 'POST', body: { agent: { id, enabled: !agent.enabled } } });
  } else if (act === 'edit') {
    openAgentModal(agent);
  } else if (act === 'del') {
    if (!confirm(`删除角色「${agent.name}」？`)) return;
    await api('/api/agents/delete', { method: 'POST', body: { id } });
    toast('已删除');
  }
});

$('addAgentBtn').onclick = () => openAgentModal(null);

function openAgentModal(agent) {
  $('agentModalTitle').textContent = agent ? `编辑：${agent.name}` : '新建角色';
  $('f_id').value = agent ? agent.id : '';
  $('f_name').value = agent ? agent.name : '';
  $('f_emoji').value = agent ? agent.emoji : '🤖';
  $('f_color').value = agent ? agent.color : '#7c9cff';
  $('f_model').value = agent ? agent.model : 'deepseek-chat';
  $('f_apiBase').value = agent ? agent.apiBase : 'https://api.deepseek.com/v1';
  $('f_apiKey').value = '';
  $('f_temperature').value = agent ? agent.temperature : 0.7;
  $('f_enabled').value = agent ? String(agent.enabled) : 'true';
  $('f_canModifyFiles').value = agent ? String(agent.canModifyFiles !== false) : 'true';
  $('f_systemPrompt').value = agent ? agent.systemPrompt : '你是一个有自己立场和想法的角色。';
  $('keyHint').textContent = agent && agent.hasKey ? '（已保存，留空则不修改）' : '（尚未配置）';

  // WorldBox 房间：为这个角色指定扮演哪个国家
  const wb = S.active && S.active.worldbox;
  const isWorld = !!(wb && wb.enabled);
  $('f_nationField').hidden = !isWorld;
  if (isWorld) {
    const cur = (agent && agent.worldboxNation) || '';
    const opts = ['<option value="">（未指定）</option>']
      .concat((wb.nations || []).map((n) => `<option value="${esc(n.name)}">${esc(n.name)}${n.live === false ? '（已灭亡）' : ''} · 军 ${n.army ?? '?'} 人口 ${n.population ?? '?'}</option>`));
    $('f_nation').innerHTML = opts.join('');
    $('f_nation').value = cur;
    if (cur && !(wb.nations || []).some((n) => n.name === cur)) {
      $('f_nation').innerHTML += `<option value="${esc(cur)}">${esc(cur)}（当前，世界数据里没有）</option>`;
      $('f_nation').value = cur;
    }
  }

  $('agentModal').hidden = false;
  setTimeout(() => $('f_name').focus(), 30);
}

function collectAgentForm() {
  const id = $('f_id').value || undefined;
  const key = $('f_apiKey').value;
  const agent = {
    id,
    name: $('f_name').value.trim() || '未命名',
    emoji: $('f_emoji').value.trim() || '🤖',
    color: $('f_color').value,
    model: $('f_model').value.trim() || 'deepseek-chat',
    apiBase: $('f_apiBase').value.trim() || 'https://api.deepseek.com/v1',
    temperature: Number($('f_temperature').value),
    enabled: $('f_enabled').value === 'true',
    canModifyFiles: $('f_canModifyFiles').value === 'true',
    systemPrompt: $('f_systemPrompt').value,
  };
  if (key.trim()) agent.apiKey = key.trim();
  return agent;
}

$('saveAgentBtn').onclick = async () => {
  try {
    const a = collectAgentForm();
    if (!a.id) delete a.id;
    const wb = S.active && S.active.worldbox;
    const nation = (! $('f_nationField').hidden) ? $('f_nation').value : null;
    const saved = await api('/api/agents', { method: 'POST', body: { agent: a } });
    if (nation !== null && wb && wb.enabled) {
      await api('/api/worldbox', {
        method: 'POST',
        body: { nationOf: { [saved.agent.name]: nation } },
      });
    }
    $('agentModal').hidden = true;
    toast('已保存', 'ok');
  } catch (e) { toast('保存失败：' + e.message, 'err'); }
};

$('testAgentBtn').onclick = async () => {
  const btn = $('testAgentBtn');
  btn.disabled = true; btn.textContent = '测试中…';
  try {
    const d = await api('/api/test', { method: 'POST', body: { agent: collectAgentForm() } });
    toast(`✅ 连接成功：${d.model} 回复「${d.reply}」`, 'ok');
  } catch (e) { toast('❌ 连接失败：' + e.message, 'err'); }
  finally { btn.disabled = false; btn.textContent = '🔌 测试连接'; }
};

/* ------------------------- 交互：世界存档选择 ------------------------- */

/*
 * 存档列表有两个来源，字段拼写**不一样**，这里两种都认：
 *   GET /api/worldbox/saves     → Python 原始行：key / index / kind_label / world_name /
 *                                 time_local / age_text / stale / has_stats / size_mb
 *   GET /api/state 的 worldbox  → 已映射：world / age / sizeMb / hasStats …
 * 只认一种的话，换个来源整列就会空白（本项目有四处白名单序列化，吃过这个亏）。
 */
function wbSaveField(s, ...names) {
  for (const n of names) {
    if (s && s[n] != null && s[n] !== '') return s[n];
  }
  return null;
}

function wbIsRunning() {
  return !!(S.running && (S.runningRoomId == null || S.runningRoomId === (S.active && S.active.id)));
}

/** 一个存档在下拉框里的一行说明。 */
function wbSaveLabel(s, opts = {}) {
  const bits = [];
  if (!opts.noIndex) {
    const idx = wbSaveField(s, 'index');
    if (idx != null) bits.push('#' + idx);
  }
  if (!opts.noWorld) {
    const w = wbSaveField(s, 'world', 'world_name');
    if (w) bits.push(String(w));
  }
  bits.push(String(wbSaveField(s, 'kind', 'kind_label') || '存档'));
  const t = wbSaveField(s, 'time', 'time_local');
  if (t) bits.push(String(t));
  const age = wbSaveField(s, 'age', 'age_text');
  if (age) bits.push('距今 ' + age);
  const mb = wbSaveField(s, 'sizeMb', 'size_mb');
  if (mb != null) bits.push(mb + ' MB');
  if (wbSaveField(s, 'hasStats', 'has_stats') === false) bits.push('无统计库');
  return bits.join(' · ');
}

/** 读取存档列表并填进下拉框。列表按世界分组——同一个世界常有十几份自动存档。 */
async function loadWbSaves() {
  const sel = $('r_wbSave');
  const meta = $('r_wbSaveMeta');
  if (!sel || !meta) return;
  sel.disabled = true;
  sel.innerHTML = '<option value="">（正在读取存档列表…）</option>';
  try {
    const r = await fetch('/api/worldbox/saves');
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || ('HTTP ' + r.status));

    const rows = d.saves || [];
    const locked = d.locked || '';
    const groups = new Map();
    for (const s of rows) {
      const w = String(wbSaveField(s, 'world', 'world_name') || '（未知世界）');
      if (!groups.has(w)) groups.set(w, []);
      groups.get(w).push(s);
    }

    const html = ['<option value="">跟随最新存档（不锁定）</option>'];
    for (const [world, list] of groups) {
      html.push(`<optgroup label="${esc(world)}（${list.length} 份）">`);
      for (const s of list) {
        const key = wbSaveField(s, 'key');
        // <option> 里没法上色，过期的只能用 ⚠️ 标出来
        const stale = wbSaveField(s, 'stale') ? '⚠️ ' : '';
        const active = wbSaveField(s, 'selected') ? '✅ ' : '';
        const use = String(key) === String(locked) ? ' selected' : '';
        html.push(`<option value="${esc(key)}"${use}>${active}${stale}${esc(wbSaveLabel(s, { noWorld: true }))}</option>`);
      }
      html.push('</optgroup>');
    }
    sel.innerHTML = html.join('');
    sel.value = locked;

    const cur = rows.find((s) => String(wbSaveField(s, 'key')) === String(locked)) || null;
    // /api/v1/saves 的「当前选择」是一个对象 {requested, using, mode, matches}，不是字符串。
    // 这里只取 using：mode 不可信——数据服务启动时读到的持久化锁定会被报成「跟随最新存档」
    // （见 docs/多国演练发现-1国到20国.md 的 P4）。前端不显示 mode。
    const selRaw = d.selection;
    const using = (selRaw && typeof selRaw === 'object') ? (selRaw.using || null) : (selRaw || null);
    const effective = locked || using || null;
    const staleNow = cur ? !!wbSaveField(cur, 'stale')
      : !!(S.active && S.active.worldbox && S.active.worldbox.status && S.active.worldbox.status.stale);

    const bits = [];
    bits.push('本房间：' + (locked ? '已锁定 <b>' + esc(locked) + '</b>' : '未锁定，跟随最新'));
    if (effective) {
      bits.push('当前生效 <b>' + esc(effective) + '</b>' + (using && String(using) !== String(locked || '') ? '（由数据服务的存档选择决定）' : ''));
    }
    bits.push('共 ' + esc(d.count != null ? d.count : rows.length) + ' 份存档');
    if (staleNow) bits.push('⚠️ 当前这份已过期，游戏可能没开，世界局势多半已经变了');
    meta.innerHTML = bits.join('　·　');
    meta.className = 'tip' + (staleNow ? ' save-stale' : '');
    if (d.dataDir) meta.innerHTML += `<br><span class="save-dir">数据目录：${esc(d.dataDir)}</span>`;
    if (d.error) meta.innerHTML += `<br><span class="save-stale">读取存档列表出错：${esc(d.error)}</span>`;
    if (wbIsRunning()) meta.innerHTML += '<br><span class="save-stale">房间正在运行，先停止才能切换存档。</span>';

    sel.disabled = wbIsRunning();
  } catch (e) {
    sel.innerHTML = '<option value="">（读不到存档列表）</option>';
    sel.disabled = true;
    meta.className = 'tip save-stale';
    meta.textContent = '读不到存档列表：' + e.message +
      '。请确认 python worldbox_agent.py serve 正在运行（默认 http://127.0.0.1:8777）。';
  }
}

/** 切换存档。成功后按新世界重建领袖，所以整个面板要重画。 */
async function switchWbSave(key) {
  const sel = $('r_wbSave');
  const meta = $('r_wbSaveMeta');
  if (!sel || !meta) return;
  sel.disabled = true;
  meta.className = 'tip';
  meta.textContent = '正在切换存档…（重新读取世界，并按新世界重建领袖）';
  try {
    // 注意：变量不要叫 res —— 会遮蔽别处的响应对象（这个项目踩过）
    const r = await fetch('/api/worldbox/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key }),
    });
    const d = await r.json().catch(() => ({}));

    if (r.status === 409) {
      toast('房间正在运行，请先停止再切换存档', 'err');
      meta.className = 'tip save-stale';
      meta.textContent = '房间正在运行，不接受切换存档。请先点「停止」，再回来选存档。';
      return;
    }
    if (!r.ok) throw new Error(d.error || ('HTTP ' + r.status));

    await loadState();
    const st = d.worldbox && d.worldbox.status;
    toast('已切换到 ' + (d.switched || (key || '最新存档')) +
      (st ? `（${st.worldName} 第 ${st.year} 年，存活 ${st.liveKingdoms} 国）` : '') +
      (d.rebuilt ? `，领袖重建 ${d.rebuilt} 位` : ''), 'ok');
    if (d.warning) toast('⚠️ ' + d.warning, 'err');
    openRoomModal();            // 领袖名单变了，重画面板（会重新拉存档列表）
  } catch (e) {
    toast('切换存档失败：' + e.message, 'err');
    meta.className = 'tip save-stale';
    meta.textContent = '切换失败：' + e.message;
    sel.disabled = wbIsRunning();
  }
}

{
  const sel = $('r_wbSave');
  if (sel) {
    sel.onchange = (e) => switchWbSave(e.target.value);
    $('r_wbSaveReload').onclick = () => loadWbSaves();
  }
}

/* ------------------------- 交互：房间设置 ------------------------- */

function openRoomModal() {
  $('r_title').value = S.active.name || '';
  $('r_setting').value = S.active.setting || '';
  $('r_maxTurns').value = S.active.maxTurns ?? 40;
  $('r_maxToolSteps').value = S.active.maxToolSteps ?? 4;
  $('r_historyLimit').value = S.active.historyLimit ?? 60;
  $('r_temperature').value = S.active.temperature ?? 0.7;
  $('r_followMentions').checked = S.active.followMentions !== false;

  const wb = S.active.worldbox;
  const isWorld = !!(wb && wb.enabled);
  $('r_worldboxBox').hidden = !isWorld;
  if (isWorld) {
    $('r_wbBaseUrl').value = wb.baseUrl || 'http://127.0.0.1:8777';
    $('r_wbStrict').value = String(wb.strictTick !== false);
    $('r_wbCap').value = wb.maxActionsPerTurn || 3;
    const names = (wb.nations || []).map((n) => n.name);
    $('r_nationAssign').innerHTML = S.active.agents.map((a) => {
      const cur = a.worldboxNation || '';
      const opts = ['<option value="">（未指定）</option>']
        .concat(names.map((n) => `<option value="${esc(n)}" ${n === cur ? 'selected' : ''}>${esc(n)}</option>`));
      if (cur && !names.includes(cur)) opts.push(`<option value="${esc(cur)}" selected>${esc(cur)}（世界数据里没有）</option>`);
      return `<div class="assign-row">
        <span class="assign-name">${esc(a.emoji || '🤖')} ${esc(a.name)}</span>
        <select data-nation-for="${esc(a.name)}">${opts.join('')}</select>
      </div>`;
    }).join('');
    // 存档列表走独立接口（/api/state 刻意不带完整列表，只带数量）
    loadWbSaves();
  }

  $('roomModal').hidden = false;
}
$('settingsBtn').onclick = openRoomModal;
$('editSettingBtn').onclick = openRoomModal;

$('r_autoAssign').onclick = async () => {
  try {
    const d = await api('/api/worldbox', { method: 'POST', body: { autoAssign: true } });
    await loadState();
    toast('已按顺序自动分配国家', 'ok');
    openRoomModal();
  } catch (e) { toast('分配失败：' + e.message, 'err'); }
};

$('saveRoomBtn').onclick = async () => {
  try {
    const wb = S.active.worldbox;
    const body = {
      name: $('r_title').value,
      setting: $('r_setting').value,
      maxTurns: Number($('r_maxTurns').value) || 40,
      maxToolSteps: Number($('r_maxToolSteps').value) || 4,
      historyLimit: Number($('r_historyLimit').value) || 60,
      temperature: Number($('r_temperature').value),
      followMentions: $('r_followMentions').checked,
    };
    if (wb && wb.enabled) {
      body.worldbox = {
        baseUrl: $('r_wbBaseUrl').value.trim(),
        strictTick: $('r_wbStrict').value === 'true',
        maxActionsPerTurn: Number($('r_wbCap').value) || 3,
      };
      const nationOf = {};
      document.querySelectorAll('#r_nationAssign select[data-nation-for]').forEach((sel) => {
        nationOf[sel.dataset.nationFor] = sel.value;
      });
      await api('/api/worldbox', { method: 'POST', body: { nationOf, ...body.worldbox } });
    }
    await api('/api/room', { method: 'POST', body });
    $('roomModal').hidden = true;
    await loadState();
    toast('房间设置已保存', 'ok');
  } catch (e) { toast('保存失败：' + e.message, 'err'); }
};

document.querySelectorAll('[data-close]').forEach((b) => (b.onclick = () => ($(b.dataset.close).hidden = true)));
document.querySelectorAll('.modal-backdrop').forEach((bd) => {
  bd.addEventListener('mousedown', (e) => { if (e.target === bd) bd.hidden = true; });
});
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    document.querySelectorAll('.modal-backdrop').forEach((m) => (m.hidden = true));
    if (S.innerAgentId) { S.innerAgentId = null; renderInner(); }
  }
});

/* ------------------------- 交互：内心抽屉 ------------------------- */

$('innerCloseBtn').onclick = () => { S.innerAgentId = null; renderInner(); };
$('innerRefreshBtn').onclick = async () => { await loadState(); };
$('innerOnlyAct').onchange = (e) => { S.innerOnlyAct = e.target.checked; renderInner(); };
$('chatScroll').addEventListener('click', (e) => {
  const link = e.target.closest('.inner-link');
  if (!link) return;
  S.innerAgentId = link.dataset.agent;
  renderInner();
});

/* ------------------------- 交互：文件 ------------------------- */

$('saveFileBtn').onclick = async () => {
  if (!S.editingFile) return;
  try {
    await api('/api/file', { method: 'POST', body: { path: S.editingFile, content: $('fileContent').value } });
    toast('文件已保存', 'ok');
    refreshFiles();
  } catch (e) { toast('保存失败：' + e.message, 'err'); }
};

$('deleteFileBtn').onclick = async () => {
  if (!S.editingFile || !confirm(`删除 ${S.editingFile}？`)) return;
  await api('/api/file/delete', { method: 'POST', body: { path: S.editingFile } });
  $('fileEditor').hidden = true; S.editingFile = null; refreshFiles(); toast('已删除');
};

$('closeFileBtn').onclick = () => { $('fileEditor').hidden = true; S.editingFile = null; renderFiles(); };

/* ------------------------- 交互：输入 & @ ------------------------- */

const input = $('input');
const pop = $('mentionPop');
let mentionStart = -1;

input.addEventListener('input', () => {
  input.style.height = 'auto';
  input.style.height = Math.min(input.scrollHeight, 180) + 'px';
  const pos = input.selectionStart;
  const before = input.value.slice(0, pos);
  const m = before.match(/@([^\s@]*)$/);
  if (m && S.active) {
    mentionStart = pos - m[1].length - 1;
    const q = m[1].toLowerCase();
    const list = S.active.agents.filter((a) => a.enabled && a.name.toLowerCase().includes(q));
    if (list.length) {
      pop.innerHTML = list.map((a) => `<div data-name="${esc(a.name)}">${esc(a.emoji || '🤖')} ${esc(a.name)}</div>`).join('');
      pop.hidden = false;
      return;
    }
  }
  pop.hidden = true;
  mentionStart = -1;
});

pop.addEventListener('mousedown', (e) => {
  const d = e.target.closest('div[data-name]');
  if (!d) return;
  e.preventDefault();
  const pos = input.selectionStart, value = input.value;
  const head = value.slice(0, mentionStart), tail = value.slice(pos);
  input.value = head + '@' + d.dataset.name + ' ' + tail;
  const np = head.length + d.dataset.name.length + 2;
  input.setSelectionRange(np, np);
  pop.hidden = true;
  input.focus();
});

async function send() {
  const text = input.value.trim();
  if (!text) return;
  input.value = ''; input.style.height = 'auto'; pop.hidden = true;
  try {
    await api('/api/message', { method: 'POST', body: { text, autoStart: $('autoStartChk').checked } });
  } catch (e) { toast('发送失败：' + e.message, 'err'); input.value = text; }
}

$('sendBtn').onclick = send;
input.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
  if (e.key === 'Escape') pop.hidden = true;
});

/* ------------------------- 启动 ------------------------- */

(async () => {
  try {
    await loadState();
    connectSSE();
  } catch (e) { toast('初始化失败：' + e.message, 'err'); }
  setInterval(() => { if (!S.running) refreshFiles(); }, 6000);
})();
